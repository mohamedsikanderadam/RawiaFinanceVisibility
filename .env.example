# PostgreSQL connection string
DATABASE_URL=postgres://rawia:CHANGE_ME@localhost:5432/rawia_finance
# Separate database used by the integration tests (it is wiped on each run)
TEST_DATABASE_URL=postgres://rawia:CHANGE_ME@localhost:5432/rawia_finance_test
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# First owner account created by `npm run db:seed` (only if no users exist)
SEED_OWNER_EMAIL=owner@rawia.cafe
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=
# Optional: costing workbook imported and activated by the seed script
SEED_WORKBOOK=tests/fixtures/rawia cafe OPS (4).xlsx
